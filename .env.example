# Copy to .env and fill in.
DAGSFLOW_ADMIN_USERNAME=admin
DAGSFLOW_ADMIN_PASSWORD=change-me-please

# Metadata database (Postgres service in docker-compose.yml)
POSTGRES_USER=dagsflow
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=dagsflow

# local | worker | kubernetes
DAGSFLOW_EXECUTOR=worker
DAGSFLOW_WORKER_CONCURRENCY=8
# delete finished runs, logs and event logs older than N days (0 = keep forever)
DAGSFLOW_RETENTION_DAYS=90
# text | json (one JSON object per log line, for log collectors)
DAGSFLOW_LOG_FORMAT=text
# Prometheus /metrics on the webserver: set a token to require "Authorization: Bearer <token>", or DAGSFLOW_METRICS=off
DAGSFLOW_METRICS_TOKEN=
# behind a reverse proxy that sets X-Forwarded-For (login rate limiting / audit use the client IP)
DAGSFLOW_TRUST_PROXY_HEADERS=false

# Encrypts variables & connections. Generate one:
#   docker compose run --rm --no-deps dagsflow-webserver config gen-key
DAGSFLOW_FERNET_KEY=

# Signs login sessions (any long random string). Empty = generated into the state volume.
DAGSFLOW_SECRET_KEY=

# Link used in Google Chat alerts
DAGSFLOW_BASE_URL=http://localhost:8080
DAGSFLOW_WEB_PORT=8080
DAGSFLOW_PARALLELISM=32

# Optional: BigQuery / GCP (put the JSON in ./keys)
# GOOGLE_APPLICATION_CREDENTIALS=/opt/dagsflow-home/keys/service-account.json
# GOOGLE_CLOUD_PROJECT=my-project

# Optional: variables/connections from env
# DAGSFLOW_VAR_REGION=APAC
# DAGSFLOW_CONN_GCHAT_ALERTS={"Type":"google_chat","Config":{"webhook_url":"https://chat.googleapis.com/..."}}
